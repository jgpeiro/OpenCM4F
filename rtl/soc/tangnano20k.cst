// OpenCM4F - Tang Nano 20K (GW2AR-LV18QN88C8/I7) with the 480x272 RGB LCD on the 40-pin connector
// Pin numbers from Sipeed's TangNano-20K-example (rgb_lcd/lcd_480_272, hdmi, nestang)

IO_LOC  "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC  "btn_s1" 88;
IO_PORT "btn_s1" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "btn_s2" 87;
IO_PORT "btn_s2" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// rotary encoder module (KY-040 style, its own pull-ups; the internal ones are on as well)
IO_LOC  "enc_clk" 20;
IO_PORT "enc_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "enc_dt" 19;
IO_PORT "enc_dt" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "enc_sw" 18;
IO_PORT "enc_sw" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "lcd_clk" 77;
IO_PORT "lcd_clk" IO_TYPE=LVCMOS33 DRIVE=24;
IO_LOC  "lcd_de" 48;
IO_PORT "lcd_de" IO_TYPE=LVCMOS33 DRIVE=24;
IO_LOC  "lcd_hsync" 25;
IO_PORT "lcd_hsync" IO_TYPE=LVCMOS33 DRIVE=24;
IO_LOC  "lcd_vsync" 26;
IO_PORT "lcd_vsync" IO_TYPE=LVCMOS33 DRIVE=24;

IO_LOC  "lcd_r[0]" 42;
IO_LOC  "lcd_r[1]" 41;
IO_LOC  "lcd_r[2]" 40;
IO_LOC  "lcd_r[3]" 39;
IO_LOC  "lcd_r[4]" 38;
IO_PORT "lcd_r[0]" IO_TYPE=LVCMOS33 DRIVE=24;
IO_PORT "lcd_r[1]" IO_TYPE=LVCMOS33 DRIVE=24;
IO_PORT "lcd_r[2]" IO_TYPE=LVCMOS33 DRIVE=24;
IO_PORT "lcd_r[3]" IO_TYPE=LVCMOS33 DRIVE=24;
IO_PORT "lcd_r[4]" IO_TYPE=LVCMOS33 DRIVE=24;

IO_LOC  "lcd_g[0]" 37;
IO_LOC  "lcd_g[1]" 36;
IO_LOC  "lcd_g[2]" 35;
IO_LOC  "lcd_g[3]" 34;
IO_LOC  "lcd_g[4]" 33;
IO_LOC  "lcd_g[5]" 32;
IO_PORT "lcd_g[0]" IO_TYPE=LVCMOS33 DRIVE=24;
IO_PORT "lcd_g[1]" IO_TYPE=LVCMOS33 DRIVE=24;
IO_PORT "lcd_g[2]" IO_TYPE=LVCMOS33 DRIVE=24;
IO_PORT "lcd_g[3]" IO_TYPE=LVCMOS33 DRIVE=24;
IO_PORT "lcd_g[4]" IO_TYPE=LVCMOS33 DRIVE=24;
IO_PORT "lcd_g[5]" IO_TYPE=LVCMOS33 DRIVE=24;

IO_LOC  "lcd_b[0]" 31;
IO_LOC  "lcd_b[1]" 30;
IO_LOC  "lcd_b[2]" 29;
IO_LOC  "lcd_b[3]" 28;
IO_LOC  "lcd_b[4]" 27;
IO_PORT "lcd_b[0]" IO_TYPE=LVCMOS33 DRIVE=24;
IO_PORT "lcd_b[1]" IO_TYPE=LVCMOS33 DRIVE=24;
IO_PORT "lcd_b[2]" IO_TYPE=LVCMOS33 DRIVE=24;
IO_PORT "lcd_b[3]" IO_TYPE=LVCMOS33 DRIVE=24;
IO_PORT "lcd_b[4]" IO_TYPE=LVCMOS33 DRIVE=24;

// on-board LEDs (active low)
IO_LOC  "led[0]" 15;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "led[1]" 16;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
